digraph printer_fleet_connections {
  rankdir=LR; graph [bgcolor="transparent", fontname="DejaVu Sans", pad="0.25", ranksep="0.6"];
  node [fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07", shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#285f8f"];
  edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7, color="#334155"];
  api [label="/api/printer/{fleet,connection,\nprofile,status,...}"];
  tools [label="Tool Registry\nprinter.prepare / device.health"];
  manager [label="PrinterDeviceBridgeManager\nprofile + memory", penwidth=2];
  prusa_workflow [label="PrinterAgenticWorkflow", shape=component, fillcolor="#eee8ff", color="#654ea3"];
  bambu_provider [label="Bambu provider clients", shape=component, fillcolor="#eee8ff", color="#654ea3"];
  bambu_protocol [label="Bambu Studio\nMQTT TLS / FTPS / video", shape=component, fillcolor="#eee8ff", color="#654ea3"];
  prusa_protocol [label="PrusaSlicer\nPrusaLink HTTP", shape=component, fillcolor="#eee8ff", color="#654ea3"];
  devices [label="Selected physical printer", shape=octagon, style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  state [label="fleet memory + status\nartifacts + proof", shape=note, fillcolor="#e7f6ec", color="#29733b"];
  api -> manager; tools -> manager; manager -> bambu_provider [label="Bambu selected", style=dashed]; manager -> prusa_workflow [label="Prusa selected", style=dashed];
  bambu_provider -> bambu_protocol; prusa_workflow -> prusa_protocol; bambu_protocol -> devices [label="gated"]; prusa_protocol -> devices [label="gated"];
  manager -> state [label="selection", color="#29733b"]; bambu_protocol -> state [label="evidence", color="#29733b"]; prusa_protocol -> state [label="evidence", color="#29733b"];
}
