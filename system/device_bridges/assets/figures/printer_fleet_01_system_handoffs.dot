digraph printer_fleet_handoffs {
  rankdir=LR; graph [bgcolor="transparent", fontname="DejaVu Sans", pad="0.25", nodesep="0.35", ranksep="0.55"];
  node [fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07", shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#285f8f"];
  edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7, color="#334155"];
  specimen [label="Specimen Agent\nfabrication payload"];
  operator [label="Operator /printer\nprofile + connection"];
  tool [label="printer.prepare\ndevice.health"];
  selector [label="Printer Fleet\nprofile selector", penwidth=2];
  gate [label="Known + enabled\nexact profile?", shape=diamond, style="filled", fillcolor="#fff3cd", color="#946200"];
  bambu [label="Bambu X2D\nprovider", shape=component, fillcolor="#eee8ff", color="#654ea3"];
  prusa [label="Prusa MK4S\nprovider", shape=component, fillcolor="#eee8ff", color="#654ea3"];
  physical [label="Printer storage / heat / motion", shape=octagon, style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  evidence [label="selection + provider\nstatus/artifacts/proof", shape=note, fillcolor="#e7f6ec", color="#29733b"];
  blocked [label="BLOCKED\nunknown/disabled profile", style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  specimen -> tool; operator -> selector [label="configure"];
  tool -> selector -> gate; gate -> bambu [label="provider=bambulab_x2d", style=dashed]; gate -> prusa [label="provider=prusa_mk4s", style=dashed];
  gate -> blocked [label="no", color="#a32929"]; bambu -> physical [label="after provider gates"]; prusa -> physical [label="after provider gates"];
  bambu -> evidence [label="evidence", color="#29733b"]; prusa -> evidence [label="evidence", color="#29733b"]; evidence -> specimen [label="handoff", color="#29733b"];
}
