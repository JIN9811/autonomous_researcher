digraph printer_fleet_execution {
  rankdir=LR; graph [bgcolor="transparent", fontname="DejaVu Sans", pad="0.25"];
  node [fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07", shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#285f8f"];
  edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7, color="#334155"];
  input [label="Payload + fleet memory"];
  resolve [label="Resolve profile hints\nactive -> default"];
  valid [label="Enabled profile\nand provider?", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  redact [label="Build redacted\nselection record"];
  dispatch [label="Dispatch exact provider", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  preflight [label="Provider validation\nmode + capability + proof"];
  invoke [label="Provider invoke"];
  effect [label="FIRST EXTERNAL EFFECT\nprovider network/device", shape=octagon, style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  observe [label="Status + artifact identity", shape=note, fillcolor="#e7f6ec", color="#29733b"];
  unknown [label="EFFECT UNKNOWN\nreconcile before retry", style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  blocked [label="Known no effect\nvalidation blocked", style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  input -> resolve -> valid; valid -> redact [label="yes"]; valid -> blocked [label="no", color="#a32929"];
  redact -> dispatch; dispatch -> preflight [label="Bambu or Prusa"]; preflight -> invoke [label="allow"]; preflight -> blocked [label="deny", color="#a32929"];
  invoke -> effect [label="live only"]; invoke -> observe [label="test/local evidence", style=dashed, color="#29733b"]; effect -> observe [label="evidence", color="#29733b"]; effect -> unknown [label="timeout/no response", color="#a32929"];
}
