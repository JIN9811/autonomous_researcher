digraph utm_vision_handoffs {
  rankdir=LR; graph [bgcolor="transparent", fontname="DejaVu Sans", pad="0.25"];
  node [fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07", shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#285f8f"];
  edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7, color="#334155"];
  vision [label="Vision Agent\ncapture / pose / cross-check"];
  equipment [label="Equipment Agent\nUTM readiness/state"];
  manipulation [label="Manipulation Agent\nfresh pose/camera context"];
  operator [label="Operator Vision/UTM\nprocess + camera + calibration"];
  boundary [label="UTM Vision Boundary", penwidth=2];
  runtime [label="ROS runtime + camera + pose\nstate observer", shape=component, fillcolor="#eee8ff", color="#654ea3"];
  physical [label="Observed UTM / specimen / scene\n(no control authority)", shape=octagon, style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  evidence [label="graph + frame + timestamp\npose/expiry + state sequence", shape=note, fillcolor="#e7f6ec", color="#29733b"];
  blocked [label="stale / unavailable / insufficient\nblock downstream effect", style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  vision -> boundary; equipment -> boundary; manipulation -> boundary; operator -> boundary; boundary -> runtime; physical -> runtime [label="observation", dir=back]; runtime -> evidence [label="evidence", color="#29733b"]; evidence -> vision [color="#29733b"]; evidence -> equipment [color="#29733b"]; evidence -> manipulation [color="#29733b"]; boundary -> blocked [label="validation failure", color="#a32929"];
}
