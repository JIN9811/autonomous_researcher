digraph windows_handoffs {
  rankdir=LR; graph [bgcolor="transparent", fontname="DejaVu Sans", pad="0.25"];
  node [fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07", shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#285f8f"];
  edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7, color="#334155"];
  equipment [label="Equipment Agent\nprofile + registered program"];
  vision [label="Vision Agent\nfresh specimen/equipment proof"];
  operator [label="Operator\ncandidate + locators + review"];
  guardian [label="Guardian\napproval / stop", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  bridge [label="Windows PyAutoGUI Bridge", penwidth=2];
  desktop [label="Windows desktop + UTM app\npossible instrument action", shape=octagon, style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  evidence [label="screenshot + step trace + request log\nCSV + Vision + proof package", shape=note, fillcolor="#e7f6ec", color="#29733b"];
  analysis [label="Analysis Agent\nvalidated measurement artifact"];
  recovery [label="review / stop-abort / reconcile", style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  equipment -> bridge; vision -> bridge [label="evidence", color="#29733b"]; operator -> bridge; guardian -> bridge [label="gate"]; bridge -> desktop [label="token + live gates", style=dashed]; desktop -> evidence [label="observed", color="#29733b"]; bridge -> evidence [label="trace/log", color="#29733b"]; evidence -> analysis [label="qualified handoff", color="#29733b"]; bridge -> recovery [label="blocked/unknown", color="#a32929"];
}
