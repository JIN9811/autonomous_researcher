digraph DesignDecision {
 graph [rankdir=TB,bgcolor="white",pad=0.25,nodesep=0.4,ranksep=0.45,label="Design: local decision layer, not an all-LLM pipeline",labelloc=t,fontname="DejaVu Sans"];
 node [shape=box,style="rounded,filled",fillcolor="#f1f5f9",fontname="DejaVu Sans",fontsize=11];
 edge [fontname="DejaVu Sans",fontsize=10,color="#475569"];
 prep [label="_prepare_design_payload\nExisting inputs / candidates / numeric checks"];
 evidence [label="design_evaluation.v1\nValidity / per-rule margins / estimated cost\nPerformance: unassessed without matched evidence"];
 model [label="LLM: design_reasoning\nInterpret suitability + evidence sufficiency\nChoose one local tool and cite evidence",fillcolor="#dbeafe"];
 gate [shape=diamond,label="Schema / tool / arguments\nEvidence IDs / call + time budget",fillcolor="#fff7ed"];
 inspect [label="inspect_candidate / inspect_history\nRead-only existing evidence"];
 accept [shape=diamond,label="accept_candidate\nValid + authorized + locked inputs?",fillcolor="#fff7ed"];
 finish [label="_finalize_design_payload\nExisting preview / reports / checked handoff"];
 owner [label="return_to_owner / invalid / timeout\nNo new ready experiment_spec",fillcolor="#fee2e2"];
 archive [label="KNOWLEDGE / EVIDENCE\nExisting run / loop / agent / attempt",fillcolor="#dcfce7"];
 prep -> evidence -> model -> gate;
 gate -> inspect [label="inspect"]; inspect -> model [label="observation",constraint=false];
 gate -> accept [label="accept"]; accept -> finish [label="pass"]; accept -> owner [label="fail"];
 gate -> owner [label="return / invalid"];
 model -> owner [style=dashed,label="timeout / exhausted"];
 finish -> archive [style=dashed]; owner -> archive [style=dashed];
}
