digraph manipulation_execution_effect_boundary {
  graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.30", ranksep="0.43", fontname="DejaVu Sans", label="Manipulation initial-transfer execution and effect boundary", labelloc="t", fontsize=18];
  node [shape=box, style="rounded,filled", fillcolor="#EEF4FF", color="#315C9B", fontname="DejaVu Sans", fontsize=12, margin="0.09,0.06"];
  edge [color="#52667A", fontname="DejaVu Sans", fontsize=10, arrowsize=0.65];
  resolve [label="01 initial-transfer task resolve\ntransfer_to_utm"];
  context [label="02 Vision + specimen context"];
  gate [label="03 profile · policy · fresh Vision\ncamera return · live approval", shape=diamond, fillcolor="#FFF1D6", color="#B26A00"];
  backend [label="04 Manipulation LLM\nskill suitability + bounded tool choice", fillcolor="#E8E2FF"];
  rollout [label="05 bounded rollout start", shape=octagon, fillcolor="#FFE9E7", color="#A33A32", penwidth=2];
  monitor [label="06 events/status\n07 observed task stage"];
  verify [label="08 existing Vision + confirmed stop\nthen Vision evidence acceptance", shape=diamond, fillcolor="#FFF1D6", color="#B26A00"];
  decide [label="09 Manipulation LLM\naccept task result / return to owner", shape=diamond, fillcolor="#E8E2FF", color="#B26A00"];
  report [label="10 report/result\n11 rollout evidence"];
  evidence [label="Session · logs · status\nimage · result · dataset/checkpoint", shape=note, fillcolor="#E9F7EF", color="#2E7D59"];
  stop [label="Stop + status + visual review", fillcolor="#FFE9E7", color="#A33A32", penwidth=2];
  resolve -> context -> gate;
  gate -> backend [label="pass"];
  gate -> stop [label="blocked"];
  backend -> rollout -> monitor -> verify;
  backend -> stop [label="rejected / invalid / changed scope"];
  verify -> decide [label="fresh match"];
  verify -> stop [label="failed / stale"];
  decide -> report [label="verified handoff"];
  decide -> stop [label="review required; no new motion"];
  rollout -> evidence [label="evidence", color="#2E7D59"];
  monitor -> evidence [label="evidence", color="#2E7D59"];
  report -> evidence [label="evidence", color="#2E7D59"];
}
