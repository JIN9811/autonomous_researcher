#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @./omx_table_layout.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    over "Workspace"
    {
        over "RightDiskAluminumTop"
        {
            double3 xformOp:translate = (0.515, 0.21, 0.068)
        }

        over "RightDiskBlackBase"
        {
            double3 xformOp:translate = (0.515, 0.21, 0.028)
        }

        over "RightDiskCenterYellowMarker"
        {
            double3 xformOp:translate = (-0.075, 0.132, 0.016)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
