#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["NewtonSceneAPI", "PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        custom bool physxScene:enableCCD = 1
        custom bool physxScene:enableStabilization = 1
        custom float physxScene:bounceThresholdVelocity = 0.01
        custom float physxScene:frictionCorrelationDistance = 0.00625
        custom float physxScene:frictionOffsetThreshold = 0.002
        uniform token physxScene:broadphaseType = "GPU"
        uint physxScene:gpuFoundLostAggregatePairsCapacity = 8192
        uint physxScene:gpuTotalAggregatePairsCapacity = 8192
        uniform token physxScene:solverType = "TGS"
        custom int physxScene:timeStepsPerSecond = 240
    }

    def "Materials"
    {
        def Material "desk_redwood_laminate"
        {
            token outputs:surface.connect = </World/Materials/desk_redwood_laminate/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.42, 0.095, 0.04)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "desk_redwood_textured"
        {
            token outputs:surface.connect = </World/Materials/desk_redwood_textured/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.1, 0.045)
                color3f inputs:diffuseColor.connect = </World/Materials/desk_redwood_textured/WoodTexture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.58
                token outputs:surface
            }

            def Shader "PrimvarReader_st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "WoodTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @/home/jin/autonomous_researcher/sim/robotis_omx/scene/Textures/redwood_table_grain.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/Materials/desk_redwood_textured/PrimvarReader_st.outputs:result>
                color3f outputs:rgb
            }
        }

        def Material "desk_dark_redwood_edge"
        {
            token outputs:surface.connect = </World/Materials/desk_dark_redwood_edge/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.045, 0.022)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "a4_matte_white"
        {
            token outputs:surface.connect = </World/Materials/a4_matte_white/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.93, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.78
                token outputs:surface
            }
        }

        def Material "aluminum_disk"
        {
            token outputs:surface.connect = </World/Materials/aluminum_disk/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.69, 0.62)
                float inputs:metallic = 0.15
                float inputs:roughness = 0.35
                token outputs:surface
            }
        }

        def Material "dark_base"
        {
            token outputs:surface.connect = </World/Materials/dark_base/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.02, 0.018)
                float inputs:metallic = 0
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "red_test_cube"
        {
            token outputs:surface.connect = </World/Materials/red_test_cube/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.05, 0.04)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "wood_laminate_contact_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0
            float physics:staticFriction = 0.45
        }

        def Material "paper_contact_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.9
            float physics:restitution = 0
            float physics:staticFriction = 1.1
        }

        def Material "pla_specimen_contact_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 1
            float physxMaterial:compliantContactDamping = 1000
            float physxMaterial:compliantContactStiffness = 100000
            uniform token physxMaterial:frictionCombineMode = "max"
        }

        def Material "blue_corner_marker"
        {
            token outputs:surface.connect = </World/Materials/blue_corner_marker/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.42, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "yellow_center_marker"
        {
            token outputs:surface.connect = </World/Materials/yellow_center_marker/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.88, 0.02)
                float inputs:metallic = 0
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }
    }

    def "Table"
    {
        def Cube "TableTop" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </World/Materials/desk_redwood_laminate>
            custom rel material:binding:physics = </World/Materials/wood_laminate_contact_physics>
            custom token physics:approximation = "box"
            bool physics:collisionEnabled = 1
            double size = 1
            float3 xformOp:scale = (0.7, 0.33, 0.03)
            double3 xformOp:translate = (0.35, 0.285, -0.015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

