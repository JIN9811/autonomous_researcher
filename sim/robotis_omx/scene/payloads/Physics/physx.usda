#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "tn__omxscene_h8"
    doc = """Generated from Composed Stage of root layer /tmp/tmpo3nr2xdn/omx scene.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_scene_5taoa0x7/usdex_scene/omx scene.usdc


