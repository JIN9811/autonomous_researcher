+    stacked = torch.stack(frames, dim=0)
+    if isinstance(target, torch.Tensor) and target.ndim == 4:
+        stacked = stacked.to(device=target.device)
+        if target.dtype.is_floating_point:
+            stacked = stacked.to(dtype=target.dtype)
+    return stacked
