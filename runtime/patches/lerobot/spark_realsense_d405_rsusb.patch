+def _atr_raw_depth_png_to_tensor(path: Path, config: dict, target: torch.Tensor | None = None) -> torch.Tensor:
+    if not path.is_file():
+        raise RuntimeError(f"ATR raw depth frame is missing: {path}")
+    try:
+        raw = np.asarray(PIL.Image.open(path))
+    except OSError as exc:
+        raise RuntimeError(f"ATR raw depth frame cannot be read: {path}: {exc}") from exc
+    if raw.ndim == 3:
+        raw = raw[..., 0]
+    if raw.ndim != 2:
+        raise RuntimeError(f"ATR raw depth frame must be HxW uint16-like data, got shape={raw.shape}: {path}")
+
+    scale_mm_per_unit = float(config["depth_scale_m_per_unit"]) * 1000.0
+    depth_mm = raw.astype(np.float32) * scale_mm_per_unit
+    clip_min = float(config["depth_clip_min_mm"])
+    clip_max = float(config["depth_clip_max_mm"])
+    normalized = np.clip((depth_mm - clip_min) / (clip_max - clip_min), 0.0, 1.0)
+    tensor = torch.from_numpy(normalized).unsqueeze(0).repeat(3, 1, 1).to(dtype=torch.float32)
