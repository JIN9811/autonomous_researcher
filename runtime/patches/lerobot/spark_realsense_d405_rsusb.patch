+    camera_dir.mkdir(parents=True)
+    PIL.Image.fromarray(np.full((2, 2), 500, dtype=np.uint16)).save(camera_dir / "frame_000001.png")
+    PIL.Image.fromarray(np.full((2, 2), 1500, dtype=np.uint16)).save(camera_dir / "frame_000002.png")
+    (sidecar_root / "transform_manifest.json").write_text(
+        json.dumps(
+            {
+                "camera_keys": ["wrist"],
+                "depth_scale_m_per_unit": 0.001,
+                "depth_clip_min_mm": 0.0,
+                "depth_clip_max_mm": 2000.0,
+            }
+        ),
+        encoding="utf-8",
+    )
+    monkeypatch.setenv("ATR_LEROBOT_RAW_DEPTH_ADAPTER", "1")
+    monkeypatch.setenv("ATR_LEROBOT_RAW_DEPTH_SOURCE_DIR", str(sidecar_root))
+
+    config = _atr_raw_depth_adapter_config(
+        tmp_path,
+        {"observation.images.wrist_depth": {"dtype": "video", "shape": [3, 2, 2]}},
+    )
+    tensor = _atr_raw_depth_sequence_to_tensor(
+        config,
