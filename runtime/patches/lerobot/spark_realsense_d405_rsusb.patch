+        _atr_raw_depth_png_to_tensor(
+            Path(config["root"]) / camera_key / f"frame_{frame_index:06d}.png",
+            config,
+            target[0] if isinstance(target, torch.Tensor) and target.ndim == 4 else target,
+        )
+        for frame_index in frame_indices
+    ]
+    if isinstance(target, torch.Tensor) and target.ndim == 3:
+        return frames[0]
+    if len(frames) == 1 and not (isinstance(target, torch.Tensor) and target.ndim == 4):
