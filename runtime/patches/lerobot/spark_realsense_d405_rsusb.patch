+                size=tuple(target.shape[-2:]),
+                mode="bilinear",
+                align_corners=False,
+            ).squeeze(0)
+        tensor = tensor.to(device=target.device)
+        if target.dtype.is_floating_point:
+            tensor = tensor.to(dtype=target.dtype)
+    return tensor
