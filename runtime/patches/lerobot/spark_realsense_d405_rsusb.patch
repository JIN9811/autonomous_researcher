+import json
+
+import numpy as np
+import PIL.Image
+import torch
+
+from lerobot.datasets.lerobot_dataset import (
+    LeRobotDataset,
+    _atr_raw_depth_adapter_config,
+    _atr_raw_depth_sequence_to_tensor,
+)
+
+
+def test_atr_raw_depth_adapter_replaces_depth_feature_from_uint16_sidecar(tmp_path, monkeypatch):
+    sidecar_root = tmp_path / "sidecar" / "depth_raw"
+    camera_dir = sidecar_root / "top"
+    camera_dir.mkdir(parents=True)
+    PIL.Image.fromarray(np.full((4, 5), 1000, dtype=np.uint16)).save(camera_dir / "frame_000000.png")
+    (sidecar_root / "transform_manifest.json").write_text(
+        json.dumps(
+            {
+                "camera_keys": ["top"],
+                "depth_scale_m_per_unit": 0.001,
+                "depth_clip_min_mm": 0.0,
+                "depth_clip_max_mm": 2000.0,
+            }
+        ),
+        encoding="utf-8",
+    )
+    monkeypatch.setenv("ATR_LEROBOT_RAW_DEPTH_ADAPTER", "1")
+    monkeypatch.setenv("ATR_LEROBOT_RAW_DEPTH_SOURCE_DIR", str(sidecar_root))
+
+    config = _atr_raw_depth_adapter_config(
+        tmp_path,
+        {"observation.images.top_depth": {"dtype": "video", "shape": [3, 4, 5]}},
+    )
+    tensor = _atr_raw_depth_sequence_to_tensor(
+        config,
+        "top",
+        [0],
+        torch.zeros(3, 4, 5),
+    )
+
+    assert tensor.shape == (3, 4, 5)
+    assert tensor.dtype == torch.float32
+    assert torch.allclose(tensor, torch.full((3, 4, 5), 0.5))
+
+
+def test_atr_raw_depth_adapter_stacks_delta_frames(tmp_path, monkeypatch):
+    sidecar_root = tmp_path / "sidecar" / "depth_raw"
