+import json
+
+import numpy as np
+import cv2
+
+from lerobot.robots.omx_follower.omx_follower import OmxFollower
+
+
+class _FakeBus:
+    is_connected = True
+    motors = {
+        "shoulder_pan": object(),
+        "shoulder_lift": object(),
+        "elbow_flex": object(),
+        "wrist_flex": object(),
+        "wrist_roll": object(),
+        "gripper": object(),
+    }
+
+    def sync_read(self, _key):
+        return {name: 0.0 for name in self.motors}
+
+
+class _FakeCameraConfig:
+    width = 640
+    height = 480
+    use_depth = True
+
+
+class _FakeCamera:
+    is_connected = True
+
+    def async_read_color_depth(self):
+        color = np.full((480, 640, 3), 16, dtype=np.uint8)
+        depth_mm = np.full((480, 640), 1000, dtype=np.uint16)
+        return color, depth_mm
+
+
+def _fake_follower() -> OmxFollower:
+    follower = OmxFollower.__new__(OmxFollower)
+    follower.id = "test-omx"
+    follower.bus = _FakeBus()
+    follower.config = type("Config", (), {"cameras": {"top": _FakeCameraConfig()}})()
+    follower.cameras = {"top": _FakeCamera()}
+    return follower
+
+
+def test_omx_follower_exposes_realsense_depth_as_visual_feature():
+    follower = _fake_follower()
+
+    features = follower.observation_features
+
+    assert features["top"] == (480, 640, 3)
+    assert features["top_depth"] == (480, 640, 3)
+
+
+def test_omx_follower_returns_depth_visual_frame_for_realsense_camera():
+    follower = _fake_follower()
+
+    observation = follower.get_observation()
+
+    assert observation["top"].shape == (480, 640, 3)
+    assert observation["top_depth"].shape == (480, 640, 3)
+    assert observation["top_depth"].dtype == np.uint8
+    assert observation["top_depth"].min() > 0
+
+
+def test_omx_follower_writes_raw_uint16_depth_sidecar_when_enabled(tmp_path, monkeypatch):
+    follower = _fake_follower()
+    monkeypatch.setenv("ATR_LEROBOT_RAW_DEPTH_DIR", str(tmp_path))
