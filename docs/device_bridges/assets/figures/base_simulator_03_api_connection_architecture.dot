digraph simulator_connections {
  rankdir=LR; graph [bgcolor="transparent", fontname="DejaVu Sans", pad="0.25", ranksep="0.55"];
  node [fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07", shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#285f8f"];
  edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7, color="#334155"];
  surfaces [label="Existing agent/workspace APIs\n(mode displayed)"];
  tools [label="register_mock_tools\n+ direct test fixtures"];
  base [label="BaseBridge contract"];
  printer [label="PrinterSimulator\nlocal workflow/files", shape=component, fillcolor="#f1f5f9", color="#64748b"];
  camera [label="CameraSimulator", shape=component, fillcolor="#f1f5f9", color="#64748b"];
  robot [label="RobotSimulator", shape=component, fillcolor="#f1f5f9", color="#64748b"];
  utm [label="UTMSimulator", shape=component, fillcolor="#f1f5f9", color="#64748b"];
  stubs [label="RobotBridge / UTMMacroBridge\ncompatibility stubs", shape=component, fillcolor="#f1f5f9", color="#64748b"];
  evidence [label="synthetic status / frame / score\nresult path + source label", shape=note, fillcolor="#e7f6ec", color="#29733b"];
  no_device [label="No hardware/protocol connection", shape=octagon, style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  surfaces -> tools -> base; base -> printer; base -> camera; base -> robot; base -> utm; base -> stubs [style=dashed, label="shell only"]; printer -> evidence [color="#29733b"]; camera -> evidence [color="#29733b"]; robot -> evidence [color="#29733b"]; utm -> evidence [color="#29733b"]; stubs -> evidence [style=dashed, color="#29733b"]; evidence -> no_device [label="terminates", color="#a32929"];
}
