digraph lerobot_handoffs {
  rankdir=LR; graph [bgcolor="transparent", fontname="DejaVu Sans", pad="0.25"];
  node [fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07", shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#285f8f"];
  edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7, color="#334155"];
  manipulation [label="Manipulation Agent\ntransfer policy / UTM-clear episode"];
  vision [label="Vision Agent\nfresh scene/camera evidence"];
  operator [label="Operator /lerobot\nports + confirmation"];
  guardian [label="Guardian\nrisk / allow / stop", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  bridge [label="LeRobotBridge", penwidth=2];
  replay [label="Managed replay runner\nlocal episode + saved calibration", shape=component, fillcolor="#eee8ff", color="#654ea3"];
  clearance [label="Vision Verification 2\nreplay success + measured return\n+ fresh empty UTM", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  isaac [label="Isaac render / Mimic / RL / mirror", shape=component, fillcolor="#eee8ff", color="#654ea3"];
  robot [label="Leader/follower robot\nserial + camera + motion", shape=octagon, style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  evidence [label="session + telemetry + frames\ndatasets + checkpoints + summaries", shape=note, fillcolor="#e7f6ec", color="#29733b"];
  review [label="review / stop / reconcile scene", style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  manipulation -> bridge; vision -> bridge [label="evidence", color="#29733b"]; operator -> bridge; guardian -> bridge [label="gate"];
  bridge -> robot [label="live gated", style=dashed]; bridge -> isaac [label="optional sidecar", style=dashed]; robot -> evidence [label="observed state", color="#29733b"]; isaac -> evidence [label="derived artifacts", color="#29733b"]; bridge -> evidence [label="session/status", color="#29733b"]; evidence -> manipulation [label="handoff", color="#29733b"]; bridge -> review [label="failure/unknown", color="#a32929"];
  bridge -> replay [label="UTM-clear start/status/stop"];
  replay -> robot [label="Live only: recorded action", style=dashed];
  replay -> evidence [label="scoped result + measured return", color="#29733b"];
  evidence -> clearance [label="required before Analysis", color="#29733b"];
}
