digraph prusa_connections {
  rankdir=LR; graph [bgcolor="transparent", fontname="DejaVu Sans", pad="0.25", ranksep="0.6"];
  node [fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07", shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#285f8f"];
  edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7, color="#334155"];
  api [label="/api/printer\nfleet / connection / profile\nstatus / autoejection"];
  tool [label="printer.prepare\ndevice.health"];
  workflow [label="PrinterAgenticWorkflow"];
  validator [label="GCodeSafetyValidator\nBounds + Ejection builder"];
  slicer [label="PrusaSlicer wrapper", shape=component, fillcolor="#eee8ff", color="#654ea3"];
  auth [label="Auth resolver\ndigest / API key / basic", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  link [label="PrusaLink HTTP\nstatus/storage/job/transfer", shape=component, fillcolor="#eee8ff", color="#654ea3"];
  virtual [label="Virtual PrusaLink\ntest only", shape=component, fillcolor="#f1f5f9", color="#64748b"];
  printer [label="Prusa MK4S", shape=octagon, style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  evidence [label="G-code + response + job evidence", shape=note, fillcolor="#e7f6ec", color="#29733b"];
  api -> workflow; tool -> workflow; workflow -> validator; workflow -> slicer; workflow -> auth [label="live", style=dashed]; auth -> link; link -> printer [label="gated upload/start"]; workflow -> virtual [label="test default", style=dashed]; validator -> evidence [label="evidence", color="#29733b"]; link -> evidence [label="evidence", color="#29733b"]; virtual -> evidence [label="synthetic", style=dashed, color="#29733b"];
}
