digraph utm_vision_execution {
  rankdir=LR; graph [bgcolor="transparent", fontname="DejaVu Sans", pad="0.25"];
  node [fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07", shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#285f8f"];
  edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7, color="#334155"];
  input [label="Runtime/camera/pose request"];
  resolve [label="Resolve workspace / script / setup\ntopics / camera profile"];
  probe [label="Paths + process + topic +\ndevice available?", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  start [label="Start ROS/calibration\nor claim camera"];
  local [label="LOCAL/DEVICE SIDE EFFECT\nprocess + camera lease", shape=octagon, style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  capture [label="Capture frame / pose /\nsummary sample window"];
  valid [label="Identity + freshness + confidence\n+ temporal stability?", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  evidence [label="frame/pose/state evidence", shape=note, fillcolor="#e7f6ec", color="#29733b"];
  downstream [label="Downstream physical gate\n(separate authority)", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  blocked [label="BLOCKED / virtual-labeled", style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  input -> resolve -> probe; probe -> start [label="ready"]; probe -> blocked [label="no", color="#a32929"]; start -> local -> capture -> valid; valid -> evidence [label="valid", color="#29733b"]; valid -> blocked [label="stale/weak", color="#a32929"]; evidence -> downstream [label="evidence", color="#29733b"];
}
