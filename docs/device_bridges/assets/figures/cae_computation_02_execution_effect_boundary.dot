digraph cae_execution {
  rankdir=LR; graph [bgcolor="transparent", fontname="DejaVu Sans", pad="0.25"];
  node [fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07", shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#285f8f"];
  edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7, color="#334155"];
  input [label="CAE / deck / dataset-model request"];
  validate [label="Schema + IDs + config valid?", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  prepare [label="Write request/deck/dataset"];
  available [label="Executable/model available +\nruntime gate enabled?", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  execute [label="Deterministic compute / ccx /\nregistry operation"];
  effect [label="COMPUTE EFFECT\nfilesystem + subprocess/resources", shape=octagon, style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  post [label="Check return + DAT/FRD/model\npostprocess artifacts"];
  evidence [label="input identity + logs + outputs\nstep trace + status", shape=note, fillcolor="#e7f6ec", color="#29733b"];
  blocked [label="BLOCKED / UNAVAILABLE", style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  partial [label="TIMEOUT / PARTIAL\nretain and inspect", style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  input -> validate; validate -> prepare [label="yes"]; validate -> blocked [label="no", color="#a32929"]; prepare -> available; available -> execute [label="allow"]; available -> blocked [label="no", color="#a32929"]; execute -> effect -> post -> evidence [label="evidence", color="#29733b"]; effect -> partial [label="timeout/nonzero", color="#a32929"];
}
