digraph lerobot_execution {
  rankdir=LR; graph [bgcolor="transparent", fontname="DejaVu Sans", pad="0.25"];
  node [fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07", shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#285f8f"];
  edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7, color="#334155"];
  input [label="Task + profile + workflow"];
  resolve [label="Resolve inherited profile\nports / cameras / policy"];
  validate [label="Supported + live/allow flags\nports/policy valid?", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  confirm [label="Operator + Guardian +\nfresh Vision gate", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  command [label="Build command + session ID"];
  process [label="Start registered subprocess"];
  effect [label="ROBOT EFFECT\nserial control / motion", shape=octagon, style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  observe [label="PID/status/logs/joints/frames", shape=note, fillcolor="#e7f6ec", color="#29733b"];
  stop [label="Matching stop/control\n+ scene verification"];
  blocked [label="BLOCKED\nknown no motion", style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  unknown [label="EFFECT UNKNOWN\nprocess + robot + scene audit", style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  input -> resolve -> validate; validate -> confirm [label="valid"]; validate -> blocked [label="invalid", color="#a32929"]; confirm -> command [label="allow"]; confirm -> blocked [label="deny", color="#a32929"];
  command -> process; process -> effect [label="hardware workflow", style=dashed]; process -> observe [label="test/sidecar", style=dashed, color="#29733b"]; effect -> observe [label="evidence", color="#29733b"]; observe -> stop; process -> unknown [label="start timeout", color="#a32929"]; effect -> unknown [label="lost telemetry", color="#a32929"];
}
