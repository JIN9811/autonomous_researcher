digraph prusa_handoffs {
  rankdir=LR; graph [bgcolor="transparent", fontname="DejaVu Sans", pad="0.25"];
  node [fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07", shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#285f8f"];
  edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7, color="#334155"];
  specimen [label="Specimen Agent\nSTL/G-code + intent"];
  fleet [label="Printer Fleet\nPrusa profile selected"];
  operator [label="Operator /printer\nconnection + calibration"];
  workflow [label="Prusa MK4S Workflow", penwidth=2];
  guardian [label="Guardian\nhealth / policy", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  printer [label="Prusa MK4S\nstorage / heat / motion", shape=octagon, style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  evidence [label="G-code identity + validation\ntransfer/job/status/ejection", shape=note, fillcolor="#e7f6ec", color="#29733b"];
  blocked [label="review / repair / stop", style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  specimen -> fleet -> workflow; operator -> workflow; guardian -> workflow [label="allow/deny"]; workflow -> printer [label="live allowed", style=dashed]; workflow -> evidence [label="local/test evidence", color="#29733b"]; printer -> evidence [label="observed state", color="#29733b"]; evidence -> specimen [label="handoff", color="#29733b"]; workflow -> blocked [label="invalid/unavailable", color="#a32929"];
}
