digraph bambu_handoffs {
  rankdir=LR; graph [bgcolor="transparent", fontname="DejaVu Sans", pad="0.25"];
  node [fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07", shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#285f8f"];
  edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7, color="#334155"];
  specimen [label="Specimen Agent\ngeometry + print intent"];
  fleet [label="Printer Fleet\nBambu profile selected"];
  operator [label="Operator /printer\nconnection + gate"];
  bridge [label="Bambu X2D Provider", penwidth=2];
  vision [label="Vision / Manipulation\npre/post eject evidence"];
  guardian [label="Guardian\nhealth + approval", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  printer [label="Bambu X2D\nstorage / print / ejection", shape=octagon, style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  artifacts [label="slice + hashes + telemetry\nvideo + bed-clear proof", shape=note, fillcolor="#e7f6ec", color="#29733b"];
  recovery [label="review / robot pickoff\n(no automatic fallback)", style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  specimen -> fleet -> bridge; operator -> bridge; vision -> bridge [label="proof", color="#29733b"]; guardian -> bridge [label="allow/deny"];
  bridge -> printer [label="live gated", style=dashed]; bridge -> artifacts [label="local + returned evidence", color="#29733b"]; printer -> artifacts [label="observed state", color="#29733b"];
  artifacts -> specimen [label="handoff", color="#29733b"]; bridge -> recovery [label="blocked/unknown", color="#a32929"];
}
