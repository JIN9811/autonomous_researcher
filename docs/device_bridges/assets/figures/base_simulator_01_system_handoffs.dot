digraph simulator_handoffs {
  rankdir=LR; graph [bgcolor="transparent", fontname="DejaVu Sans", pad="0.25"];
  node [fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07", shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#285f8f"];
  edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7, color="#334155"];
  agents [label="Test-mode Specimen / Vision /\nManipulation / Equipment"];
  tools [label="Mock tools / test fixtures"];
  mode [label="Explicit test/simulator mode?", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  base [label="BaseBridge.execute\ncommand + payload"];
  sims [label="Printer / Camera / Robot / UTM\ndeterministic simulators", shape=component, fillcolor="#f1f5f9", color="#64748b"];
  stubs [label="Robot/UTM live-named stubs\ninterface shell only", shape=component, fillcolor="#f1f5f9", color="#64748b"];
  evidence [label="labeled synthetic response\n+ fixture artifacts", shape=note, fillcolor="#e7f6ec", color="#29733b"];
  boundary [label="NO EXTERNAL DEVICE EFFECT", shape=octagon, style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  agents -> tools -> mode; mode -> base [label="yes"]; base -> sims; base -> stubs [label="compatibility", style=dashed]; sims -> evidence [label="synthetic", color="#29733b"]; stubs -> evidence [label="echo only", style=dashed, color="#29733b"]; evidence -> agents [label="test handoff", color="#29733b"]; sims -> boundary [label="path terminates", color="#a32929"];
}
