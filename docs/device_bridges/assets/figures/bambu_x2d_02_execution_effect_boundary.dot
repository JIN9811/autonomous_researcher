digraph bambu_execution {
  rankdir=LR; graph [bgcolor="transparent", fontname="DejaVu Sans", pad="0.25"];
  node [fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07", shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#285f8f"];
  edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7, color="#334155"];
  input [label="Model/artifact + Bambu profile"];
  slice [label="Bambu Studio slice\nor accept exact artifact"];
  patch [label="Pure G-code patch\nbounds + envelope + cooldown"];
  identity [label="Source/patched hashes", shape=note, fillcolor="#e7f6ec", color="#29733b"];
  preflight [label="TLS/path/profile/prestart\nproof ready?", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  draft [label="Start command draft\n(no motion)"];
  gate [label="Start/publish gate\ncomplete?", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  publish [label="FTPS upload / MQTT publish"];
  effect [label="PRINTER EFFECT\nfetch / heat / motion / eject", shape=octagon, style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  proof [label="MQTT + video + pre/post eject\n+ bed-clear evidence", shape=note, fillcolor="#e7f6ec", color="#29733b"];
  blocked [label="BLOCKED\nknown no effect", style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  unknown [label="EFFECT UNKNOWN\nquery telemetry before retry", style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  input -> slice -> patch -> identity -> preflight; preflight -> draft [label="ready"]; preflight -> blocked [label="blocker", color="#a32929"];
  draft -> gate; gate -> publish [label="allow"]; gate -> blocked [label="deny", color="#a32929"]; publish -> effect; effect -> proof [label="evidence", color="#29733b"]; publish -> unknown [label="timeout", color="#a32929"];
}
