digraph windows_connections {
  rankdir=LR; graph [bgcolor="transparent", fontname="DejaVu Sans", pad="0.25", ranksep="0.55"];
  node [fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07", shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#285f8f"];
  edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7, color="#334155"];
  api [label="/api/equipment/windows/*\nconnect / program / proof / recovery"];
  tools [label="Tool Registry\nequipment.pyautogui.*"];
  client [label="WindowsPyAutoGUIBridge\nconnection + validation"];
  gate [label="candidate / token / allowlist\nlimits / live preflight", shape=diamond, fillcolor="#fff3cd", color="#946200"];
  http [label="Token-gated HTTP\ndiscovery / health / execute", shape=component, fillcolor="#eee8ff", color="#654ea3"];
  server [label="Windows bridge server\nprogram + action executor", shape=component, fillcolor="#eee8ff", color="#654ea3"];
  pyauto [label="PyAutoGUI / window / image / file", shape=component, fillcolor="#eee8ff", color="#654ea3"];
  target [label="Desktop app / UTM instrument", shape=octagon, style="filled,bold", fillcolor="#fde8e8", color="#a32929"];
  evidence [label="screenshot / trace / request log\nCSV / Vision / proof audit", shape=note, fillcolor="#e7f6ec", color="#29733b"];
  api -> client; tools -> client; client -> gate; gate -> http [label="allow"]; http -> server -> pyauto -> target;
  server -> evidence [label="trace/log", color="#29733b"]; pyauto -> evidence [label="screen/file", color="#29733b"]; target -> evidence [label="measurement/proof", color="#29733b"];
}
