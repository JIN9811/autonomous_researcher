digraph analysis_api {
 graph [rankdir=LR,bgcolor="white",pad="0.35",nodesep="0.45",ranksep="0.65",fontname="DejaVu Sans",fontsize=20,label="Analysis — package and API ownership",labelloc=t];
 node [shape=box,style="rounded,filled",fillcolor="#EEF4FF",color="#315C9B",fontname="DejaVu Sans",fontsize=14,margin="0.2,0.12"];
 edge [color="#52667A",fontname="DejaVu Sans",fontsize=12];
 runtime [label="Runtime graph\nanalysis.task → analysis.deliver"];
 owner [label="Analysis owner\nagent.py"];
 llm [label="Registered backend\nanalysis_reasoning",fillcolor="#F2ECFA"];
 objective [label="Objective service\nBinding + measured evaluation"];
 archive [label="Run / loop / attempt archive",shape=note];
 report [label="GET /api/agents/analysis/report\nOwner projection"];
 live [label="Live GUI\nAnalysis frontend module"];
 runtime -> owner;
 owner -> llm [label="LLM call"];
 llm -> owner [style=dashed,label="bounded decision"];
 owner -> objective;
 owner -> archive;
 owner -> report [label="read-only evidence"];
 report -> live;
}
