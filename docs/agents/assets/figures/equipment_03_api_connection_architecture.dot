digraph equipment_api_connection_architecture {
  graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.35", ranksep="0.45", fontname="DejaVu Sans", label="Equipment API, model and evidence connections", labelloc="t", fontsize=18];
  node [shape=box, style="rounded,filled", fillcolor="#EEF4FF", color="#315C9B", fontname="DejaVu Sans", fontsize=12, margin="0.12,0.09"];
  edge [color="#52667A", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  author [label="Agent Manager\nstored Flow + exact Skill bindings"];
  registry [label="Linux Profile / Flow / Skill registry\nversions · deployment · annotations", shape=note, fillcolor="#E9F7EF", color="#2E7D59"];
  model [label="Registered Equipment model context\nequipment_workflow_decision\nAPI / local model · shared LLMImageInput", shape=component, fillcolor="#E8E2FF", color="#6B4C9A"];
  agent [label="Equipment agent-local decision boundary\nimmutable proposal references only", penwidth=2];
  runtime [label="EquipmentRuntimeService\nworkflow_decisions claim + terminal record\nexisting execution / checkpoint / projections"];
  gate [label="Code-owned gates\nidentity · scope · approvals · no replay", fillcolor="#FFF1D6", color="#B26A00", penwidth=2];
  tools [label="Registered equipment.pyautogui tools\nrun · health · list_programs\nscreenshot · request_log"];
  worker [label="Existing Windows / Local worker\nPyAutoGUI HTTP boundary", shape=component, fillcolor="#F2ECFA", color="#6B4C9A"];
  device [label="Desktop application + instrument\nphysical effect only through gated execution", shape=octagon, fillcolor="#FFE9E7", color="#A33A32", penwidth=2];
  evidence [label="Screenshot artifact + SHA-256\nrequest logs · raw results · CSV\nagent-bound capture identity", shape=note, fillcolor="#E9F7EF", color="#2E7D59"];
  vision [label="vision.equipment_cross_check\nconfigured task; observation only", shape=component, fillcolor="#F2ECFA", color="#6B4C9A"];
  gui [label="Equipment Workspace / Live GUI / Runtime IDE\n/api/equipment/* read-only runtime projections"];
  author -> registry [label="save; no execution"];
  registry -> agent [label="exact contract"];
  agent -> model [label="context + terminal images", color="#2E7D59"];
  model -> agent [label="bounded tool choice", color="#6B4C9A"];
  agent -> runtime -> gate -> tools -> worker -> device;
  runtime -> gui [label="projection", color="#2E7D59"];
  worker -> evidence [label="observations / raw results", color="#2E7D59"];
  evidence -> agent [label="terminal evidence", color="#2E7D59"];
  runtime -> vision [style=dashed, label="optional configured Vision slot"];
  vision -> runtime [style=dashed, label="identity / freshness evidence", color="#2E7D59"];
}
