digraph guardian_execution_effect_boundary {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.45", fontname="DejaVu Sans", label="Guardian: bounded reasoning and execution", labelloc="t", fontsize=22];
  node [shape=box, style="rounded,filled", fillcolor="#EEF4FF", color="#315C9B", fontname="DejaVu Sans", fontsize=16, margin="0.18,0.13"];
  edge [color="#52667A", fontname="DejaVu Sans", fontsize=13, arrowsize=0.8];
  collect [label="Code: bind identity and evidence\nMandatory policy / health checks"];
  gate [label="Mandatory stop?", shape=diamond, fillcolor="#FFF1D6", color="#B26A00"];
  llm [label="LLM: Guardian / Safety decision\nContinue, inspect, review or stop", fillcolor="#F2ECFA", color="#6B4C9A", penwidth=2];
  tools [label="Code: allowlisted read-only tools\nScoped evidence / failures / health / queue"];
  verify [label="Code: validate submission\nRecheck current evidence and stop state"];
  output [label="Existing AgentResult\nMandatory gate remains authoritative"];
  stop [label="Existing safe stop\nNo model wait required", fillcolor="#FFE9E7", color="#A33A32"];
  cancel [label="Operator stop / caller cancellation", shape=octagon, fillcolor="#FFE9E7", color="#A33A32"];
  collect -> gate;
  gate -> llm [label="no; retain recovery floor"];
  gate -> stop [label="yes"];
  llm -> tools [label="inspect when needed"];
  tools -> llm [label="bounded observations"];
  llm -> verify [label="structured submission"];
  verify -> output;
  stop -> output;
  cancel -> stop [style=dashed, label="preempts wait"];
}
