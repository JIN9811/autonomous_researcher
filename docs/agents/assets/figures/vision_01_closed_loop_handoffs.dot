digraph vision_closed_loop_handoffs {
  graph [rankdir=LR, bgcolor="transparent", pad="0.25", nodesep="0.32", ranksep="0.56", fontname="DejaVu Sans", label="Vision closed-loop position and bounded decisions", labelloc="t", fontsize=18];
  node [shape=box, style="rounded,filled", fillcolor="#EEF4FF", color="#315C9B", fontname="DejaVu Sans", fontsize=12, margin="0.10,0.07"];
  edge [color="#52667A", fontname="DejaVu Sans", fontsize=10, arrowsize=0.68];

  orchestrator [label="Orchestrator / graph\ncurrent bounded task", fillcolor="#F2ECFA", color="#6B4C9A"];
  specimen [label="Specimen\nejection + pickup context"];
  manipulation [label="Manipulation\nsession + placement context"];
  clearance [label="Managed clearance\nreplay complete + measured home"];

  decision [label="VISION decision layer\nexecute_verification / return", penwidth=2.2];
  existing [label="Existing Vision routines\ncapture · ActiveCam · detector", shape=component, fillcolor="#F2ECFA", color="#6B4C9A"];
  review [label="Same-capture review\nraw → annotated + detector facts", shape=diamond, fillcolor="#FFF1D6", color="#B26A00"];
  gates [label="Code-owned gates\nidentity · session · freshness · stop", shape=diamond, fillcolor="#FFF1D6", color="#B26A00"];

  consumers [label="Existing graph consumers\nSpecimen · Manipulation · Equipment · Analysis"];
  owner [label="Return to owner\nreview_required", fillcolor="#FFE9E7", color="#A33A32", penwidth=2];
  guardian [label="Guardian\nsafety authority", fillcolor="#FFE9E7", color="#A33A32"];
  knowledge [label="Knowledge / evidence\nvision_decision.v1 + reports + hashes", shape=note, fillcolor="#E9F7EF", color="#2E7D59"];
  test [label="Explicit non-LLM TEST\ndeterministic_test", style="rounded,filled,dashed", fillcolor="#F5F5F5", color="#777777"];

  orchestrator -> decision [label="run/loop/specimen/session/task scope"];
  specimen -> decision;
  manipulation -> decision;
  clearance -> decision;
  decision -> existing [label="registered contract only"];
  existing -> review [label="one capture pair"];
  review -> gates [label="accept evidence"];
  review -> owner [label="insufficient / conflict"];
  gates -> consumers [label="ready / verified"];
  gates -> owner [label="stale / mismatch / unverified"];
  guardian -> gates [label="cannot be overridden", color="#A33A32"];
  review -> knowledge [label="decision + image hashes", color="#2E7D59"];
  gates -> knowledge [label="actual disposition", color="#2E7D59"];
  test -> gates [style=dashed, label="labeled fallback"];
}
