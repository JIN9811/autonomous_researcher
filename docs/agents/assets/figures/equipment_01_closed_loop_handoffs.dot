digraph equipment_closed_loop_handoffs {
  graph [rankdir=TB, bgcolor="transparent", pad="0.25", nodesep="0.35", ranksep="0.45", fontname="DejaVu Sans", label="Equipment closed-loop position and handoffs", labelloc="t", fontsize=18];
  node [shape=box, style="rounded,filled", fillcolor="#EEF4FF", color="#315C9B", fontname="DejaVu Sans", fontsize=12, margin="0.12,0.09"];
  edge [color="#52667A", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];
  upstream [label="Orchestrator task + verified placement\ncurrent run / loop / specimen"];
  contract [label="Stored Profile + stacked Flow\nexact deployed Skills + approvals", shape=note, fillcolor="#E9F7EF", color="#2E7D59"];
  selection [label="EQUIPMENT · preflight + durable claim\nLLM selects exact Flow or requests review", fillcolor="#E8E2FF", penwidth=2];
  execution [label="Existing Flow → Runtime → worker\ndeterministic Skills + configured Vision gates\nNO intermediate Equipment LLM calls", shape=octagon, fillcolor="#FFE9E7", color="#A33A32", penwidth=2];
  terminal [label="EQUIPMENT · terminal LLM review\ncurrent screen + logs + required outputs", fillcolor="#E8E2FF", penwidth=2];
  gate [label="Code checks + accepted review\nvalidated CSV / next-test / clearance", fillcolor="#FFF1D6", color="#B26A00", penwidth=2];
  clear [label="Manipulation: clear_utm_to_disposal\nexisting managed recorded sweep"];
  vision [label="Vision Verification 2\nfresh empty-fixture evidence"];
  analysis [label="Analysis\nexisting raw-artifact handoff"];
  review [label="Operator / Guardian review\nno repeated successful work", fillcolor="#FFE9E7", color="#A33A32"];
  evidence [label="Decision + invocation archive\nscreenshot provenance · logs\nCSV · readiness · transitions", shape=note, fillcolor="#E9F7EF", color="#2E7D59"];
  upstream -> selection;
  contract -> selection;
  selection -> execution [label="eligible exact proposal"];
  selection -> review [label="blocked / rejected"];
  execution -> terminal [label="normal or error termination only"];
  execution -> evidence [label="raw evidence", color="#2E7D59"];
  terminal -> gate [label="accept existing success"];
  terminal -> review [label="uncertain / unsafe / rejected"];
  terminal -> evidence [label="decision evidence", color="#2E7D59"];
  gate -> clear -> vision -> analysis;
  gate -> review [label="missing proof"];
}
