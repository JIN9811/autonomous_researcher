digraph analysis_execution_effect_boundary {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.5", fontname="DejaVu Sans", label="Analysis: decisions, execution and effect boundaries", labelloc=t, fontsize=20];
  node [shape=box, style="rounded,filled", fillcolor="#EEF4FF", color="#315C9B", fontname="DejaVu Sans", fontsize=14, margin="0.17,0.1"];
  edge [color="#52667A", fontname="DejaVu Sans", fontsize=12];
  subgraph cluster_fg {
    label="Foreground — existing external Analysis node";color="#315C9B";fontsize=16;
    intake [label="Receive + parse + identify\nresolve finalized Design against frozen registry"];
    data [label="LLM processing decision\nexisting numeric curve + metrics"];
    assess [label="LLM evidence assessment\ncode-owned quality gates",fillcolor="#FFF1D6"];
    handoff [label="Persist + return Knowledge / BO\nno background completion dependency"];
    intake -> data -> assess -> handoff;
  }
  subgraph cluster_bg {
    label="Background — no wall deadline; finite numerical/action limits";color="#6B4C9A";fontsize=16;
    queue [label="Frozen evidence queue\nunique acquisition + scope",shape=note];
    select [label="LLM: prepare mesh / hold\nassess quality; remesh / solve",fillcolor="#F2ECFA"];
    study [label="Registered native tools\nhash-bound prepared mesh + solve\nCPU/RSS/elapsed observations"];
    validate [label="LLM: analyze actual result\nconclude / mesh convergence\nnumeric matching-interval comparisons",fillcolor="#FFF1D6"];
    outputs [label="Actual fields + curves + model package\nread-only Live cards and archive"];
    queue -> select -> study -> validate -> outputs;
    validate -> select [style=dashed,label="bounded resolution study"];
  }
  handoff -> queue [style=dashed,label="eligible evidence"];
  limits [label="Shared limits\nsource hashes / registered tools / cancellation\nno physical actuation; no automatic promotion",shape=octagon,fillcolor="#FFE9E7",color="#A33A32"];
  limits -> study [style=dashed,label="hard bounds",arrowhead=tee];
}
