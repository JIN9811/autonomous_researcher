digraph guardian_closed_loop_handoffs {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.48", fontname="DejaVu Sans", label="Guardian: evidence review in the existing loop", labelloc="t", fontsize=22];
  node [shape=box, style="rounded,filled", fillcolor="#EEF4FF", color="#315C9B", fontname="DejaVu Sans", fontsize=16, margin="0.18,0.13"];
  edge [color="#52667A", fontname="DejaVu Sans", fontsize=13, arrowsize=0.8];
  inputs [label="Current run / loop / specimen\nAgent results and policy gates"];
  evidence [label="Health, queue and failure evidence", shape=note, fillcolor="#E9F7EF", color="#2E7D59"];
  guardian [label="GuardianAgent\nMandatory checks + local LLM review", fillcolor="#F2ECFA", color="#6B4C9A", penwidth=2];
  runtime [label="Existing Orchestrator / runtime\nGuardian result contract"];
  next [label="Continue\nNext design / cycle"];
  hold [label="Review hold\nSame specimen and loop", fillcolor="#FFF1D6", color="#B26A00"];
  stop [label="Safe stop\nExisting terminal route", fillcolor="#FFE9E7", color="#A33A32"];
  archive [label="Knowledge / Evidence\nPer-loop decision and tool trace", shape=note, fillcolor="#E9F7EF", color="#2E7D59"];
  inputs -> guardian;
  evidence -> guardian [style=dashed, label="read-only evidence"];
  guardian -> runtime [label="continue / recover / safe_stop"];
  runtime -> next;
  runtime -> hold;
  runtime -> stop;
  guardian -> archive [style=dashed, label="automatic preservation"];
}
