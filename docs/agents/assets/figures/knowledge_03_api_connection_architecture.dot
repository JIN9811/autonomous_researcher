digraph knowledge_api_connection_architecture {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.5", fontname="DejaVu Sans", fontsize=18, label="Knowledge APIs use local stores; ontology and manual citations remain", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#EEF4FF", color="#315C9B", fontname="DejaVu Sans", fontsize=13, margin="0.12,0.1"];
  edge [color="#52667A", fontname="DejaVu Sans", fontsize=11, arrowsize=0.75];
  ui [label="Knowledge Workspace\nMarkdown / Memory / Ontology / Manuals"];
  api [label="Existing FastAPI app\n/api/knowledge/*"];
  md [label="Markdown store\nquery / detail / lifecycle", fillcolor="#E9F7EF", color="#2E7D59"];
  typed [label="Existing JSONL + audit ledger\npatterns / performance / Evolution"];
  ontology [label="Ontology registry\nclasses + relation definitions"];
  manuals [label="Manual corpus\nsource hashes + page citations"];
  jobs [label="Explicit background intake\nexisting archives only"];
  agent [label="Knowledge decision layer"];
  model [label="Registered API / vLLM\nknowledge_query"];
  ui -> api [label="bounded HTTP"];
  api -> md;
  api -> typed;
  api -> ontology;
  api -> manuals;
  api -> jobs [label="explicit request"];
  jobs -> md [label="no LLM / replay"];
  agent -> model [label="model call"];
  agent -> md [label="validated tools"];
}
