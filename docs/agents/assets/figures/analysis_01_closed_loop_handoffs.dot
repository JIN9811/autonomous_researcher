digraph analysis_closed_loop_handoffs {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", fontname="DejaVu Sans", label="Analysis: foreground handoff and asynchronous improvement", labelloc=t, fontsize=20];
  node [shape=box, style="rounded,filled", fillcolor="#EEF4FF", color="#315C9B", fontname="DejaVu Sans", fontsize=14, margin="0.18,0.12"];
  edge [color="#52667A", fontname="DejaVu Sans", fontsize=12, arrowsize=0.8];
  design [label="Design / runtime\ngeometry + conditions + bound objective"];
  equipment [label="Equipment\nCSV + acquisition identity + completion"];
  analysis [label="ANALYSIS — FOREGROUND\nLLM data decisions + numerical tools\nmeasured objective; no FEM wait", penwidth=2];
  output [label="Valid measured observation\nobjective + explicit quality facts"];
  knowledge [label="Knowledge\nlineage + evidence"];
  bo [label="BO\nnext experiment parameters"];
  archive [label="Immutable evidence\nCSV / STL / decisions / solver receipts",shape=note,fillcolor="#E9F7EF"];
  worker [label="ANALYSIS — BACKGROUND FEM\nLLM mesh / convergence / result decisions\nno wall deadline; explicit cancellation",fillcolor="#F2ECFA",color="#6B4C9A"];
  outputs [label="Reusable FE model + actual fields\nmatching-interval curves + progress\nLive cards: previous / next",shape=note,fillcolor="#E9F7EF"];
  registry [label="Validated model registry\nnext-loop snapshot only",fillcolor="#E9F7EF"];
  hold [label="Invalid input / held decision\ncurrent BO handoff blocked",fillcolor="#FFE9E7",color="#A33A32"];
  {rank=same; design; equipment;}
  {rank=same; knowledge; bo;}
  design -> analysis;
  equipment -> analysis;
  analysis -> output [label="accepted"];
  analysis -> hold [label="blocked"];
  output -> knowledge;
  output -> bo;
  analysis -> archive [label="evidence",color="#2E7D59"];
  archive -> worker [style=dashed,label="conditional enqueue; no handoff wait"];
  worker -> outputs;
  worker -> registry [style=dashed,label="separate independent validation required"];
  registry -> design [style=dashed,label="later-loop availability",constraint=false];
}
