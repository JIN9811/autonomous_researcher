digraph manipulation_api_connection_architecture {
  graph [rankdir=LR, bgcolor="transparent", pad="0.25", nodesep="0.28", ranksep="0.50", fontname="DejaVu Sans", label="Manipulation API and connection architecture", labelloc="t", fontsize=18];
  node [shape=box, style="rounded,filled", fillcolor="#EEF4FF", color="#315C9B", fontname="DejaVu Sans", fontsize=8.0, margin="0.08,0.06"];
  edge [color="#52667A", fontname="DejaVu Sans", fontsize=7.0, arrowsize=0.62];
  config [label="Config · ports · camera\nprofiles · sessions"];
  policy [label="Policies · files · datasets\nrecord · train · W&B"];
  runapi [label="Rollout · teleoperate\nmanipulation-agent"];
  simapi [label="Isaac · synthetic · mirror\nvisualize", shape=component, fillcolor="#F2ECFA", color="#6B4C9A"];
  service [label="LeRobot bridge +\npolicy/session services", shape=component, fillcolor="#F2ECFA", color="#6B4C9A"];
  gate [label="Profile · policy · camera\nVision · approval gate", shape=diamond, fillcolor="#FFF1D6", color="#B26A00"];
  process [label="Bounded policy process\nserial + camera", shape=component, fillcolor="#F2ECFA", color="#6B4C9A"];
  robot [label="Robot motion", shape=octagon, fillcolor="#FFE9E7", color="#A33A32", penwidth=2];
  evidence [label="Status · stop result · visual proof\nlogs · dataset · checkpoint", shape=note, fillcolor="#E9F7EF", color="#2E7D59"];
  blocked [label="No direct shell/model bypass", fillcolor="#FFE9E7", color="#A33A32", penwidth=2];
  config -> service;
  policy -> service;
  runapi -> service;
  simapi -> service [style=dashed, label="simulation/configured"];
  service -> gate -> process -> robot;
  robot -> evidence [label="evidence", color="#2E7D59"];
  evidence -> service [label="status / stop / verify", color="#2E7D59"];
  gate -> blocked [style=dashed, arrowhead=tee, label="prohibited"];
}
