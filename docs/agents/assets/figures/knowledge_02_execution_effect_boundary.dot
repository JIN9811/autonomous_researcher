digraph knowledge_execution_effect_boundary {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.4", fontname="DejaVu Sans", fontsize=18, label="LLM selects knowledge actions; code validates and persists them", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#EEF4FF", color="#315C9B", fontname="DejaVu Sans", fontsize=13, margin="0.15,0.1"];
  edge [color="#52667A", fontname="DejaVu Sans", fontsize=11, arrowsize=0.75];
  snapshot [label="Content-addressed source snapshot\nAnalysis + Guardian evidence"];
  inspect [label="inspect_evidence\nfirst-phase tool only"];
  llm [label="LLM decision\nreusability / classification / evidence gap", penwidth=2];
  search [label="search_knowledge\nmetadata + excerpts"];
  read [label="read_knowledge\nselected scoped record"];
  write [label="write_knowledge_note\nderived / hypothesis"];
  gate [label="Code-owned checks\nscope + sources + ontology + lifecycle", fillcolor="#FFF1D6", color="#916100"];
  store [label="Append-only MD revisions\nstable identity / hash / locks", fillcolor="#E9F7EF", color="#2E7D59"];
  publish [label="publish_context\nsource IDs or explicit evidence gap"];
  handoff [label="Existing typed memory + BO/Evolution handoff"];
  snapshot -> inspect -> llm;
  llm -> search [label="optional"];
  search -> read [label="selected ID"];
  read -> llm [label="observation"];
  llm -> write [label="useful new knowledge"];
  write -> gate -> store;
  store -> llm [label="receipt"];
  llm -> publish [label="enough evidence / abstain"];
  publish -> gate [style=dashed, label="validate references"];
  publish -> handoff [label="accepted"];
}
